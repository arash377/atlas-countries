{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atlas country section v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "section": {
      "enum": [
        "identity",
        "geography",
        "administration",
        "population",
        "politics",
        "history",
        "economy",
        "culture",
        "education-health",
        "sports",
        "infrastructure",
        "travel",
        "environment"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "const": "fa"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/metric"
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/topic"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "neighbors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "direction"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "map_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "longitude",
          "latitude",
          "topic",
          "description",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "topic": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "key_tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/key_table"
      }
    }
  },
  "required": [
    "schema_version",
    "country_code",
    "section",
    "revision",
    "updated_at",
    "language",
    "title",
    "topics"
  ],
  "definitions": {
    "source": {
      "type": "array",
      "items": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string",
          "pattern": "^https://"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "part": {
      "type": "array",
      "items": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "metric": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "person",
            "person-per-km2",
            "percent",
            "year",
            "km2",
            "km",
            "count"
          ]
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "reported",
            "census",
            "estimate",
            "projection",
            "derived",
            "unavailable",
            "not_applicable"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "unit",
        "period",
        "status",
        "definition",
        "source_url"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "unavailable",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "note"
            ]
          }
        }
      ]
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "chart"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "chart_type": {
              "const": "bar"
            },
            "unit": {
              "const": "percent"
            },
            "period": {
              "type": "string",
              "minLength": 1
            },
            "definition": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "reported",
                "census",
                "estimate",
                "projection",
                "derived",
                "unavailable",
                "not_applicable"
              ]
            },
            "axis_min": {
              "const": 0
            },
            "axis_max": {
              "const": 100
            },
            "series": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "status": {
                    "enum": [
                      "reported",
                      "census",
                      "estimate",
                      "projection",
                      "derived",
                      "unavailable",
                      "not_applicable"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "source_urls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          },
          "required": [
            "type",
            "id",
            "title",
            "chart_type",
            "unit",
            "period",
            "definition",
            "status",
            "axis_min",
            "axis_max",
            "series",
            "source_urls"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "table"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "id",
            "title",
            "columns",
            "rows"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "image"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "url": {
              "type": "string",
              "anyOf": [
                {
                  "pattern": "^https://"
                },
                {
                  "pattern": "^assets/[a-zA-Z0-9/_-]+\\.(webp|jpg|jpeg|png|mp3|ogg|m4a)$"
                }
              ]
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string",
              "minLength": 1
            },
            "credit": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "license_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "changes": {
              "type": "string"
            },
            "variant": {
              "enum": [
                "flag"
              ]
            }
          },
          "required": [
            "type",
            "id",
            "url",
            "alt",
            "caption",
            "credit",
            "license"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "audio"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "url": {
              "type": "string",
              "anyOf": [
                {
                  "pattern": "^https://"
                },
                {
                  "pattern": "^assets/[a-zA-Z0-9/_-]+\\.(webp|jpg|jpeg|png|mp3|ogg|m4a)$"
                }
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "transcript": {
              "type": "string",
              "minLength": 1
            },
            "credit": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "license_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "changes": {
              "type": "string"
            },
            "variant": {
              "enum": [
                "instrumental"
              ]
            },
            "duration_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "id",
            "url",
            "title",
            "transcript",
            "credit",
            "license"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "callout"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "id",
            "title",
            "text"
          ]
        }
      ]
    },
    "topic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/part"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/block"
          }
        }
      },
      "required": [
        "id",
        "title",
        "lead",
        "parts",
        "sources"
      ]
    },
    "key_table": {
      "type": "object",
      "properties": {
        "type": {
          "const": "table"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "minItems": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source"
          }
        }
      },
      "required": [
        "type",
        "id",
        "title",
        "columns",
        "rows",
        "sources"
      ]
    }
  }
}
